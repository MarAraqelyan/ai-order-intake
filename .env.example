# Copy this file to .env and fill in your values.
# Never commit the .env file - it is listed in .gitignore.

# Required for live mode only. Replay mode needs no key.
OPENAI_API_KEY=

# Optional: application model (default: gpt-4.1-mini).
# Changing it means replay needs new recordings for that model.
# OPENAI_MODEL=gpt-4.1-mini

# Optional: SQLite database file (default: orders.db in the project root).
# DB_PATH=orders.db
